build/
cmake-build/
node_modules/
benchmark/node_modules/
benchmark/package.json
benchmark/package-lock.json
# Nested lockfiles stay out; the package's own is tracked so CI installs with npm ci.
**/package-lock.json
!/package-lock.json
*.node
build_cmake/
*.trace
.cache/
.DS_Store
docs/superpowers/
benchmark/profile_*.mjs

.worktrees/

# TS test fixtures: auto-generated per run
tests/ts_fixtures/**/validator.mjs
tests/ts_fixtures/**/validator.d.mts
tests/ts_fixtures/**/validator.d.cts
tests/ts_fixtures/**/validator.cjs

# perf scoreboard rig
benchmark/.scoreboard/*.json
!benchmark/.scoreboard/baseline.json
traces/

# npm pack artifacts
*.tgz

# Deno writes a lock next to whatever it runs; the Deno job in CI needs none.
deno.lock
